--bg:#08111b;--paper:rgba(20,34,50,.72);--solid:#122030;--sheet:#101c2a;--ink:#e6eef3;--mute:#9cb0bf;--rule:rgba(200,225,240,.14);--rule2:rgba(200,225,240,.22);
--accent:#6cc4e3;--onacc:#06121c;--warm:#e2b25e;--hl:rgba(108,196,227,.12);--hl2:rgba(108,196,227,.2);
--g1:#123d55;--g2:#17607f;--g3:#15675c;--grad:linear-gradient(135deg,var(--g1) 0%,var(--g2) 52%,var(--g3) 100%);
--gsoft:linear-gradient(135deg,rgba(108,196,227,.16),rgba(80,210,180,.12));--gtext:linear-gradient(120deg,#9adcf2,#86e2cc);
--gline:rgba(255,255,255,.08);--tile:linear-gradient(135deg,#1b6587,#18705f);--hdr:rgba(8,17,27,.72);--scrim:rgba(0,0,0,.58);
--b1:rgba(40,130,170,.34);--b2:rgba(100,80,200,.22);--b3:rgba(30,150,130,.26);
--sh1:0 1px 2px rgba(0,0,0,.3),0 12px 30px -18px rgba(0,0,0,.7);--sh2:0 24px 60px -20px rgba(0,0,0,.75);--shadow:0 18px 40px -16px rgba(0,0,0,.7);
color-scheme:dark
